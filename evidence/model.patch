+// finalPathInDir resolves the final path of dg inside dir.
+func finalPathInDir(dir string) func(digest.Digest) (string, error) {
+	return func(dg digest.Digest) (string, error) {
+		return filepath.Join(dir, dg.Encoded()), nil
+	}
